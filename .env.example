# ==============================================================================
# Gym Membership — environment variables
# ==============================================================================
# Copy this file to .env (for local dev) or paste each value into Vercel's
# Settings → Environment Variables (for production).

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# In production: get this from Vercel Postgres / Neon / Supabase.
# Locally: easiest path is a free Neon project (neon.tech), use the same URL.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# NextAuth
# ------------------------------------------------------------------------------
# Generate with:  openssl rand -base64 32
# (or in PowerShell:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET="replace-with-a-long-random-string"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# In production set this to your real Vercel URL, e.g. https://yourgym.vercel.app
# Locally: http://localhost:3456
NEXTAUTH_URL="http://localhost:3456"

# ------------------------------------------------------------------------------
# Email (optional, for password reset emails)
# ------------------------------------------------------------------------------
# Sign up at https://resend.com — free tier: 3,000 emails/month, 100/day.
# Without this, password reset links will be logged to Vercel function logs
# instead of emailed (so you can still recover from a forgotten password by
# checking the logs in an emergency).
RESEND_API_KEY=""

# Optional. Default sender uses Resend's onboarding domain (only sends to the
# email registered with your Resend account). For real production, verify a
# domain at https://resend.com/domains and set this to e.g. "noreply@yourdomain.com"
RESEND_FROM=""

# ------------------------------------------------------------------------------
# Cron auth
# ------------------------------------------------------------------------------
# Bearer token Vercel Cron sends in the Authorization header on the nightly
# /api/cron/expire-subscriptions call. Generate another random string.
CRON_SECRET="replace-with-another-long-random-string"

# ------------------------------------------------------------------------------
# Gym branding (LEGACY — only used by prisma/seed.ts to seed an initial gym
# in development. In production, gym owners self-register at /register and
# their branding is stored per-gym in the database, not in env vars.)
# ------------------------------------------------------------------------------
GYM_NAME="My Gym"
GYM_ADDRESS=""
GYM_PHONE=""
